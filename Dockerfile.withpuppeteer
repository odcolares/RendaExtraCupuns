# Dockerfile para Bot Multi-Tenant (Railway/Fly.io)
# Cada container = 1 tenant (isolamento total)

FROM node:20-slim

# Instala Chromium + dependências para whatsapp-web.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Configura Puppeteer para usar Chromium do sistema
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

WORKDIR /app

# Copia package.json e instala deps de produção
COPY package*.json ./
RUN npm ci --omit=dev

# Copia build compilado
COPY dist ./dist

# Copia arquivo .env (será sobrescrito por variáveis do Railway)
COPY config/.env ./config/.env

# Entry point
COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

ENTRYPOINT ["./docker-entrypoint.sh"]
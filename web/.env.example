# Banco de dados Turso (libSQL)
DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend (envio de e-mails transacionais)
RESEND_API_KEY=
RESEND_FROM=

# URL pública do app (usada nos links de e-mail: verificação e reset de senha)
# Default de produção: https://web-gamma-hazel-30.vercel.app
NEXT_PUBLIC_APP_URL=

# NextAuth — gere com: npx auth secret (> 32 chars)
AUTH_SECRET=

# Stripe — obter em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe Webhook — obter no endpoint https://web-gamma-hazel-30.vercel.app/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — obter em https://dashboard.stripe.com/test/products
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=